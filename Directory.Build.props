<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Authors>Andy Lewis</Authors>
    <Company>Astar Digital</Company>
    <Product>NoQuit</Product>
    <Copyright>Copyright (c) Andy Lewis</Copyright>
    <RepositoryUrl>https://github.com/andyl-astardigital/no-quit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/andyl-astardigital/no-quit</PackageProjectUrl>
  </PropertyGroup>

</Project>
